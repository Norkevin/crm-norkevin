# Copy only into an approved staging environment. Do not put secrets in iOS.
FLOW_MOBILE_ENABLED=0
FLOW_MOBILE_PUSH_ENABLED=0
# Generate a dedicated Fernet key locally; preserve it for existing device tokens.
FLOW_MOBILE_ENCRYPTION_KEY=
FLOW_APNS_PRIVATE_KEY=
FLOW_APNS_KEY_ID=
FLOW_APNS_TEAM_ID=
# Provisional bundle identifier; register/confirm it in your Apple account first.
FLOW_APNS_BUNDLE_ID=com.flowingcrm.mobile
